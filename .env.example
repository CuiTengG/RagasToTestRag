# ===========================================
# Ragas 测试集生成器 - 环境配置
# ===========================================

# LLM 提供商: ollama, openai, deepseek
LLM_PROVIDER=ollama

# Ollama 配置 (当 LLM_PROVIDER=ollama 时使用)
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL_NAME=gemma2:latest

# OpenAI/DeepSeek 配置 (当 LLM_PROVIDER=openai 或 deepseek 时使用)
OPENAI_API_KEY=your_api_key_here
OPENAI_API_BASE=https://api.deepseek.com/v1
OPENAI_MODEL_NAME=deepseek-chat

# Embedding 提供商: huggingface, openai
EMBEDDING_PROVIDER=huggingface

# HuggingFace Embedding 模型 (当 EMBEDDING_PROVIDER=huggingface 时使用)
EMBEDDING_MODEL_NAME=intfloat/multilingual-e5-large  # intfloat/multilingual-e5-base、BAAI/bge-small-zh-v1.5

# OpenAI Embedding (当 EMBEDDING_PROVIDER=openai 时使用)
# OPENAI_API_KEY 和 OPENAI_API_BASE 同上

# 计算设备: auto, cuda, cpu
# auto - 自动检测 GPU（推荐）
# cuda - 强制使用 GPU
# cpu - 强制使用 CPU
DEVICE=auto

# 测试集语言: chinese, english
# Ragas 测试集生成器无法生成中文question和ground_truth的原因是由于大模型的原因，
# Gemma2模型只能生成英文question和ground_truth，而Qwen2 2.5模型只能生成中文question和ground_truth
TEST_LANGUAGE=chinese 